{
  "openapi": "3.1.0",
  "info": {
    "title": "Confidential Inference Gateway Admin API",
    "version": "1.0.0",
    "description": "The signed admin API manages gateway API keys through c8s tls-lb. The unencrypted persistent ext4 state disk is the canonical state source. Administration services are clients and are not canonical state sources."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "https://api.example.invalid",
      "description": "The c8s tls-lb entry point"
    }
  ],
  "security": [
    {
      "adminSignedRequest": []
    }
  ],
  "x-state-authority": "unencrypted-persistent-ext4-state-disk",
  "x-non-authoritative-systems": [
    "admin-client"
  ],
  "x-admin-request-signing": {
    "environmentPolicy": "deployment-defined",
    "serverDnsSource": "deployment-environment",
    "clientIdentity": "admin-backend",
    "requiredKeyMaterial": [
      "admin-client-certificate",
      "admin-client-private-key",
      "gateway-trust-certificate"
    ]
  },
  "paths": {
    "/admin/v1/health": {
      "get": {
        "operationId": "getAdminHealth",
        "summary": "Read the admin API health",
        "responses": {
          "200": {
            "description": "The admin API and its canonical state disk are ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/admin/v1/api-keys": {
      "post": {
        "operationId": "createApiKey",
        "summary": "Create an API key",
        "description": "The first successful response returns the plaintext API key once. A replay returns metadata only and does not return the plaintext value.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The API key was created. The plaintext value appears only in this response.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionEtag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateApiKeyResponse"
                }
              }
            }
          },
          "200": {
            "description": "The idempotency key already completed this request. This replay returns metadata only.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionEtag"
              },
              "Idempotency-Replayed": {
                "$ref": "#/components/headers/IdempotencyReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyMetadata"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          },
          "423": {
            "$ref": "#/components/responses/Locked"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "get": {
        "operationId": "listApiKeys",
        "summary": "List API-key metadata",
        "description": "This operation returns metadata only. It never returns key material or authorization records.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageCursor"
          },
          {
            "$ref": "#/components/parameters/PageLimit"
          }
        ],
        "responses": {
          "200": {
            "description": "The API-key metadata page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/admin/v1/api-keys/{keyId}/revoke": {
      "post": {
        "operationId": "revokeApiKey",
        "summary": "Revoke an API key",
        "parameters": [
          {
            "$ref": "#/components/parameters/KeyId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditContext"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The API key is revoked.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionEtag"
              },
              "Idempotency-Replayed": {
                "$ref": "#/components/headers/IdempotencyReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyMetadata"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          },
          "423": {
            "$ref": "#/components/responses/Locked"
          },
          "412": {
            "$ref": "#/components/responses/VersionConflict"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/admin/v1/api-keys/{keyId}": {
      "delete": {
        "operationId": "deleteApiKey",
        "summary": "Delete an API key",
        "description": "The key is revoked and its revocation metadata remains in the canonical state disk. Repeating the same idempotency request returns the recorded metadata.",
        "parameters": [
          {
            "$ref": "#/components/parameters/KeyId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditContext"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The API key is revoked and its audit metadata is retained.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionEtag"
              },
              "Idempotency-Replayed": {
                "$ref": "#/components/headers/IdempotencyReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyMetadata"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          },
          "423": {
            "$ref": "#/components/responses/Locked"
          },
          "412": {
            "$ref": "#/components/responses/VersionConflict"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/admin/v1/api-keys/export": {
      "get": {
        "operationId": "exportApiKeys",
        "summary": "Export every API-key record",
        "description": "Returns every key record in a versioned envelope for a blue-green key-store carry-over. The envelope carries a fingerprint of the pepper, never the pepper, and never a plaintext key.",
        "responses": {
          "200": {
            "description": "The full API-key export envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyExportEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/admin/v1/api-keys/import": {
      "post": {
        "operationId": "importApiKeys",
        "summary": "Import an API-key export envelope",
        "description": "Refuses the import when the pepper fingerprint differs from this gateway's own pepper. Inserts records idempotently by id in one transaction: an identical existing record is skipped, and a conflicting existing record refuses the entire import.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportApiKeysRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The import ran. A replay returns the stored counts.",
            "headers": {
              "Idempotency-Replayed": {
                "$ref": "#/components/headers/IdempotencyReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/admin/v1/api-keys/freeze": {
      "post": {
        "operationId": "freezeApiKeys",
        "summary": "Freeze API-key mints and revocations",
        "description": "Refuses new mints and revocations until unfrozen. The freeze auto-lifts after 10 minutes.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditContext"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The gateway is frozen.",
            "headers": {
              "Idempotency-Replayed": {
                "$ref": "#/components/headers/IdempotencyReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FreezeStatus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/admin/v1/api-keys/unfreeze": {
      "post": {
        "operationId": "unfreezeApiKeys",
        "summary": "Lift an API-key freeze",
        "description": "Lifts a freeze early.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditContext"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The gateway is unfrozen.",
            "headers": {
              "Idempotency-Replayed": {
                "$ref": "#/components/headers/IdempotencyReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FreezeStatus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/admin/v1/api-keys/source": {
      "get": {
        "operationId": "getApiKeySource",
        "summary": "Read the key registry read mode and cache status",
        "description": "Reports which key source the gateway reads from, the revision of the snapshot the admin VM last pushed, and the pepper fingerprint. The admin VM reads it once a minute as a drift probe.",
        "responses": {
          "200": {
            "description": "The key source status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrySourceStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/admin/v1/api-keys/snapshot": {
      "put": {
        "operationId": "putApiKeySnapshot",
        "summary": "Apply the key registry snapshot the admin VM pushed",
        "description": "The admin VM owns the API key record. It pushes the complete snapshot on every change, and again when a drift probe shows this gateway holds an older revision. The gateway checks the revision, applies the whole snapshot in one transaction, and then answers every request from its own table. The gateway never calls the admin VM. The existing admin request signature already binds this body, so the snapshot carries no second signature.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeyRegistrySnapshot"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The gateway applied the snapshot, or it already held that revision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotPushResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminSignedRequest": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-Signature",
        "description": "The gateway verifies a P-256 signature over the method, path, body hash, timestamp, and one-time nonce."
      }
    },
    "parameters": {
      "KeyId": {
        "name": "keyId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Identifier"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "A unique key for this mutation. Reuse with a different request returns 409.",
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "The strong ETag from the current resource version.",
        "schema": {
          "type": "string",
          "pattern": "^\\\"[1-9][0-9]*\\\"$"
        }
      },
      "PageCursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "PageLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      }
    },
    "headers": {
      "VersionEtag": {
        "description": "A strong ETag that contains the resource version.",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\\\"[1-9][0-9]*\\\"$"
        }
      },
      "IdempotencyReplayed": {
        "description": "True when the server replayed the stored response for this idempotency key.",
        "required": true,
        "schema": {
          "type": "boolean"
        }
      }
    },
    "schemas": {
      "Identifier": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{7,127}$"
      },
      "AuditContext": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor",
          "reason"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The dashboard user identity. The gateway also records the authenticated mTLS client identity."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "audit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "tags": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          },
          "audit": {
            "$ref": "#/components/schemas/AuditContext"
          }
        }
      },
      "CreateApiKeyResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiKey",
          "metadata",
          "keyHash",
          "pepperFingerprint"
        ],
        "properties": {
          "apiKey": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256,
            "format": "password",
            "x-sensitive": true,
            "x-one-time-response": true,
            "description": "The one-time plaintext API key. The client must store it now because no later response includes it."
          },
          "metadata": {
            "$ref": "#/components/schemas/ApiKeyMetadata"
          },
          "keyHash": {
            "type": "string",
            "description": "Base64url, no padding, of HMAC-SHA256(pepper, plaintext). The admin key registry stores this hash; it never receives the plaintext."
          },
          "pepperFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Hex SHA-256 fingerprint of the gateway pepper that produced keyHash."
          }
        }
      },
      "ApiKeyMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "prefix",
          "tags",
          "status",
          "createdAt",
          "createdBy",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "prefix": {
            "type": "string",
            "minLength": 4,
            "maxLength": 16,
            "description": "A non-secret display prefix."
          },
          "tags": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "revoked"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "revokedAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "$ref": "#/components/schemas/Version"
          }
        }
      },
      "ApiKeyListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiKeyMetadata"
            }
          },
          "nextCursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "Version": {
        "type": "integer",
        "minimum": 1
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "stateAuthority",
          "stateDisk",
          "frozen"
        ],
        "properties": {
          "status": {
            "const": "ready"
          },
          "stateAuthority": {
            "const": "unencrypted-persistent-ext4-state-disk"
          },
          "stateDisk": {
            "const": "ready"
          },
          "frozen": {
            "type": "boolean"
          },
          "frozenUntil": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "ExportedApiKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "prefix",
          "tags",
          "verifierHash",
          "createdAt",
          "createdBy",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "prefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "tags": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "verifierHash": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "The base64url-encoded peppered verifier for this key. It never discloses the plaintext key or the pepper."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "revokedAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "$ref": "#/components/schemas/Version"
          }
        }
      },
      "ApiKeyExportEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "pepperFingerprint",
          "exportedAt",
          "keys"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "confidential.ai/gateway-api-key-export/v1"
          },
          "pepperFingerprint": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "description": "A SHA-256 fingerprint of the gateway's pepper. It never discloses the pepper itself."
          },
          "exportedAt": {
            "type": "string",
            "format": "date-time"
          },
          "keys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExportedApiKey"
            }
          }
        }
      },
      "ImportApiKeysRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "pepperFingerprint",
          "keys",
          "audit"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "confidential.ai/gateway-api-key-export/v1"
          },
          "pepperFingerprint": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "exportedAt": {
            "type": "string",
            "format": "date-time"
          },
          "keys": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/ExportedApiKey"
            }
          },
          "audit": {
            "$ref": "#/components/schemas/AuditContext"
          }
        }
      },
      "ImportResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "imported",
          "skipped",
          "total"
        ],
        "properties": {
          "imported": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "FreezeStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frozen"
        ],
        "properties": {
          "frozen": {
            "type": "boolean"
          },
          "until": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegistrySourceStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "cachedRevision",
          "lastSuccessUnix",
          "staleSeconds",
          "rowCount",
          "pepperMismatchCount",
          "pepperFingerprint"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "local",
              "dual",
              "registry"
            ]
          },
          "cachedRevision": {
            "type": [
              "integer",
              "null"
            ]
          },
          "lastSuccessUnix": {
            "type": [
              "integer",
              "null"
            ]
          },
          "staleSeconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "rowCount": {
            "type": "integer",
            "minimum": 0
          },
          "pepperMismatchCount": {
            "type": "integer",
            "minimum": 0
          },
          "pepperFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "The fingerprint of the pepper this gateway holds. The admin VM's drift probe compares it against the snapshot it would push."
          }
        },
        "description": "The admin VM reads this route once a minute per gateway as a drift probe. It pushes the full snapshot only when cachedRevision is null or lower than the registry revision, or when pepperFingerprint differs."
      },
      "KeyRegistrySnapshotKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "owner",
          "prefix",
          "keyHash",
          "pepperFingerprint",
          "tags",
          "createdAt",
          "createdBy",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "The customer or team that holds the key."
          },
          "prefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "keyHash": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Base64url, no padding, of HMAC-SHA256(pepper, plaintext). It never discloses the plaintext key or the pepper."
          },
          "pepperFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Binds this hash to one pepper. The gateway skips and counts a row whose fingerprint differs from its own."
          },
          "tags": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "rateLimit": {
            "type": [
              "object",
              "null"
            ],
            "description": "Reserved. Always null in this release. The gateway accepts and ignores it."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "revokedBy": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "$ref": "#/components/schemas/Version"
          }
        }
      },
      "KeyRegistrySnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "environment",
          "revision",
          "keys"
        ],
        "properties": {
          "schemaVersion": {
            "const": "confidential.ai/key-registry-snapshot/v1"
          },
          "environment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "description": "The gateway refuses a snapshot that names another environment."
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "description": "The registry revision. The gateway applies a strictly higher revision, acknowledges an equal one, and refuses a lower one."
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "pepperFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "keys": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/KeyRegistrySnapshotKey"
            }
          }
        }
      },
      "SnapshotPushResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "cachedRevision",
          "accepted",
          "skippedPepperMismatch",
          "applied"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "cachedRevision": {
            "type": "integer",
            "minimum": 0,
            "description": "The revision the gateway holds after this push."
          },
          "accepted": {
            "type": "integer",
            "minimum": 0
          },
          "skippedPepperMismatch": {
            "type": "integer",
            "minimum": 0
          },
          "applied": {
            "type": "boolean",
            "description": "False when the push repeated the cached revision. The gateway wrote nothing, and the admin VM may treat this as an acknowledgement."
          }
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "The request is invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "The client certificate is missing or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated mTLS client cannot perform this operation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "The resource does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "IdempotencyConflict": {
        "description": "The idempotency key already identifies a different request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "VersionConflict": {
        "description": "The supplied resource version is stale.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "The canonical gateway state disk or the admin service is unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "The idempotency key conflicts, the import pepper fingerprint does not match, an imported record conflicts with an existing record, the pushed snapshot revision is lower than the cached revision, or the gateway runs in registry mode and mints no key of its own.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Locked": {
        "description": "The gateway state is frozen for an export-import-switch sequence.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
