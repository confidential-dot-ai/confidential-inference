{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment", "replicaCount", "image", "imagePullSecretName", "service", "trustedProxyCidrs", "resources"],
  "properties": {
    "environment": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"},
    "replicaCount": {"const": 1},
    "image": {
      "type": "string",
      "pattern": "^ghcr\\.io/confidential-dot-ai/confidential-inference/maintenance-gateway@sha256:[0-9a-f]{64}$"
    },
    "imagePullSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {"const": "ClusterIP"},
        "port": {"const": 443}
      }
    },
    "trustedProxyCidrs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}
    },
    "resources": {"type": "object"}
  }
}
