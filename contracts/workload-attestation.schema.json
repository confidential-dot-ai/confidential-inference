{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confidential.ai/schemas/workload-attestation.v2.json",
  "title": "Confidential Inference c8s evidence response",
  "description": "This response carries raw c8s discovery evidence, the active allowlist, and nonce-bound admission receipts. Independent verification is required. It does not prove workload liveness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "nonce", "operationalStatus", "release", "c8s", "tls", "gpuEvidence", "receipts"],
  "properties": {
    "schemaVersion": {"const": 2},
    "scope": {"const": "launch-or-admission-only"},
    "nonce": {"$ref": "#/$defs/base64url32"},
    "operationalStatus": {"const": "not-verified"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bundleSha256", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "bundleSha256": {"$ref": "#/$defs/sha256Digest"},
        "source": {"const": "operator-selected-public-release"}
      }
    },
    "c8s": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "activeAllowlist", "meshCaSha256"],
      "properties": {
        "discovery": {
          "type": "object",
          "required": ["version", "generated_at", "public_tls", "cds_tls", "attestation"],
          "properties": {
            "version": {"const": "v1"},
            "generated_at": {"type": "string", "minLength": 1},
            "public_tls": {
              "type": "object",
              "required": ["hostname", "mode"],
              "properties": {
                "hostname": {"type": "string", "minLength": 1},
                "mode": {"enum": ["webpki", "cds", "acme", "tee-webpki"]}
              }
            },
            "cds_tls": {
              "type": "object",
              "required": ["certificate_pem", "certificate_sha256"],
              "properties": {
                "certificate_pem": {"type": "string", "minLength": 1},
                "certificate_sha256": {"type": "string", "minLength": 1}
              }
            },
            "attestation": {
              "type": "object",
              "required": ["platform", "evidence"],
              "properties": {
                "platform": {"const": "tdx"},
                "evidence": {"type": "object", "minProperties": 1}
              }
            }
          }
        },
        "activeAllowlist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "document"],
          "properties": {
            "sha256": {"$ref": "#/$defs/sha256Digest"},
            "document": {"type": "object", "required": ["schema", "workloads"]}
          }
        },
        "policyTrust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "status", "reason"],
          "properties": {
            "mode": {"enum": ["operator", "static"]},
            "status": {"enum": ["evidence-present-and-release-matched", "evidence-present-requires-independent-verification"]},
            "expectedPublicKeySpkiSha256": {"$ref": "#/$defs/sha256Digest"},
            "expectedKeySetSha256": {"$ref": "#/$defs/sha256Digest"},
            "activeKeySetSha256": {"$ref": "#/$defs/sha256Digest"},
            "activeKeySetC8sSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "activeKeySetPem": {"type": "string", "minLength": 1, "maxLength": 262144},
            "expectedAllowlistSha256": {"$ref": "#/$defs/sha256Digest"},
            "activeAllowlistSha256": {"$ref": "#/$defs/sha256Digest"},
            "reason": {"type": "string", "minLength": 1}
          },
          "oneOf": [
            {"required": ["expectedPublicKeySpkiSha256", "expectedKeySetSha256", "activeKeySetSha256", "activeKeySetPem"]},
            {"required": ["expectedAllowlistSha256", "activeAllowlistSha256"]}
          ]
        },
        "operatorTrust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedPublicKeySpkiSha256", "expectedKeySetSha256", "activeKeySetStatus", "reason"],
          "properties": {
            "expectedPublicKeySpkiSha256": {"$ref": "#/$defs/sha256Digest"},
            "expectedKeySetSha256": {"$ref": "#/$defs/sha256Digest"},
            "activeKeySetStatus": {"enum": ["evidence-present-and-release-matched", "requires-attested-cds-read"]},
            "cdsAttestedReadHint": {"enum": ["/operator-keys"]},
            "activeKeySetSha256": {"$ref": "#/$defs/sha256Digest"},
            "activeKeySetC8sSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "activeKeySetPem": {"type": "string", "minLength": 1, "maxLength": 262144},
            "reason": {"type": "string", "minLength": 1}
          },
          "allOf": [
            {
              "comment": "requires-attested-cds-read is the honest status for a gateway that cannot read the key set: CDS serves GET /operator-keys over RA-TLS behind a self-signed certificate. Such a response must name the route the verifier reads for itself, and must claim no active key set at all.",
              "if": {"properties": {"activeKeySetStatus": {"const": "requires-attested-cds-read"}}, "required": ["activeKeySetStatus"]},
              "then": {
                "required": ["cdsAttestedReadHint"],
                "not": {"anyOf": [
                  {"required": ["activeKeySetSha256"]},
                  {"required": ["activeKeySetPem"]},
                  {"required": ["activeKeySetC8sSha256"]}
                ]}
              },
              "else": {"required": ["activeKeySetSha256", "activeKeySetPem"]}
            }
          ]
        },
        "meshCaSha256": {"$ref": "#/$defs/sha256Digest"},
        "attestationProtocol": {"enum": ["c8s/attest-pq/v1", "c8s/attest-pq/v1+xwing"]},
        "attestationProtocolC8sCommit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
      },
      "oneOf": [
        {"required": ["policyTrust"]},
        {"required": ["operatorTrust"]}
      ]
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "binding"],
      "properties": {
        "mode": {"enum": ["webpki", "cds", "acme", "tee-webpki"]},
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "publicKeySha256", "reason"],
          "properties": {
            "status": {"enum": ["not-proven", "requires-attest-lb", "verified"]},
            "publicKeySha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "frontDoor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["source", "receipt"],
      "properties": {
        "source": {"const": "c8s-tls-lb"},
        "receipt": {"$ref": "#/$defs/c8sReceipt"}
      }
    },
    "gpuEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "reason"],
      "properties": {
        "status": {"enum": ["not-exposed-by-c8s", "raw-receipt-evidence", "verified"]},
        "evidence": {"type": "array", "maxItems": 64},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "receipts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "workload", "identity", "admittedLaunch", "receipt"],
        "properties": {
          "target": {"enum": ["gateway", "sglang-router", "inference-worker-0", "inference-worker-1", "metrics-collector", "kube-state-metrics"]},
          "workload": {"$ref": "#/$defs/workloadPolicyName"},
          "identity": {"$ref": "#/$defs/workloadPolicyName"},
          "admittedLaunch": {"$ref": "#/$defs/admittedLaunch"},
          "receipt": {"$ref": "#/$defs/c8sReceipt"}
        },
        "oneOf": [
          {"properties": {"target": {"const": "gateway"}, "workload": {"pattern": "^gateway(?:-[a-z0-9][a-z0-9-]{0,54})?$"}}},
          {"properties": {"target": {"const": "sglang-router"}, "workload": {"pattern": "^sglang-router(?:-[a-z0-9][a-z0-9-]{0,48})?$"}}},
          {"properties": {"target": {"const": "inference-worker-0"}, "workload": {"pattern": "^inference-worker-0(?:-[a-z0-9][a-z0-9-]{0,43})?$"}}},
          {"properties": {"target": {"const": "inference-worker-1"}, "workload": {"pattern": "^inference-worker-1(?:-[a-z0-9][a-z0-9-]{0,43})?$"}}},
          {"properties": {"target": {"const": "metrics-collector"}, "workload": {"pattern": "^metrics-collector(?:-[a-z0-9][a-z0-9-]{0,44})?$"}}},
          {"properties": {"target": {"const": "kube-state-metrics"}, "workload": {"pattern": "^kube-state-metrics(?:-[a-z0-9][a-z0-9-]{0,43})?$"}}}
        ]
      },
      "anyOf": [
        {
          "allOf": [
            {"contains": {"properties": {"target": {"const": "gateway"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"target": {"const": "sglang-router"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"target": {"const": "inference-worker-0"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"target": {"const": "inference-worker-1"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1}
            ,{"contains": {"properties": {"target": {"const": "metrics-collector"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1}
            ,{"contains": {"properties": {"target": {"const": "kube-state-metrics"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1}
          ]
        },
        {
          "allOf": [
            {"contains": {"properties": {"target": {"const": "gateway"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"target": {"const": "sglang-router"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"target": {"const": "inference-worker-0"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"target": {"const": "inference-worker-1"}}, "required": ["target"]}, "minContains": 0, "maxContains": 0}
            ,{"contains": {"properties": {"target": {"const": "metrics-collector"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1}
            ,{"contains": {"properties": {"target": {"const": "kube-state-metrics"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1}
          ]
        },
        {
          "allOf": [
            {"contains": {"properties": {"target": {"const": "gateway"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"target": {"const": "sglang-router"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"target": {"const": "inference-worker-0"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"target": {"const": "inference-worker-1"}}, "required": ["target"]}, "minContains": 1, "maxContains": 1}
            ,{"contains": {"properties": {"target": {"const": "metrics-collector"}}, "required": ["target"]}, "minContains": 0, "maxContains": 0}
            ,{"contains": {"properties": {"target": {"const": "kube-state-metrics"}}, "required": ["target"]}, "minContains": 0, "maxContains": 0}
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["tls"],
        "properties": {"tls": {"required": ["mode"], "properties": {"mode": {"enum": ["cds", "acme", "tee-webpki"]}}}}
      },
      "then": {
        "required": ["frontDoor"],
        "properties": {"frontDoor": {"type": "object"}}
      }
    },
    {
      "if": {
        "required": ["tls"],
        "properties": {"tls": {"required": ["mode"], "properties": {"mode": {"const": "webpki"}}}}
      },
      "then": {
        "required": ["frontDoor"],
        "properties": {"frontDoor": {"type": "null"}}
      }
    }
  ],
  "$defs": {
    "workloadPolicyName": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sha256Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "base64url32": {"type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"},
    "base64url": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$"},
    "base64urlXwingEk": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1622}$"},
    "base64urlXwingCt": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1494}$"},
    "base64urlSessionId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22}$"},
    "admittedLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyName", "initContainers", "containers"],
      "properties": {
        "policyName": {"$ref": "#/$defs/workloadPolicyName"},
        "initContainers": {
          "type": "array",
          "items": {"$ref": "#/$defs/exactLaunch"}
        },
        "containers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/exactLaunch"}
        }
      }
    },
    "exactLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "digest", "argv"],
      "properties": {
        "image": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"},
        "digest": {"$ref": "#/$defs/sha256Digest"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "c8sReceipt": {
      "type": "object",
      "required": ["version", "platform", "generation", "nonce", "evidence", "cds_cert_pem", "identity_proof"],
      "oneOf": [
        {
          "required": ["session_pubkey"],
          "properties": {"version": {"const": "c8s/attest-pq/v1"}}
        },
        {
          "required": ["xwing_ek", "xwing_ct", "session_id"],
          "properties": {"version": {"const": "c8s/attest-pq/v1"}},
          "not": {"required": ["session_pubkey"]}
        },
        {
          "required": ["serving_leaf_sha256"],
          "properties": {"version": {"const": "c8s/attest-lb/v1"}},
          "not": {"required": ["session_pubkey"]}
        }
      ],
      "properties": {
        "version": {"enum": ["c8s/attest-pq/v1", "c8s/attest-lb/v1"]},
        "platform": {"const": "tdx"},
        "generation": {"const": ""},
        "nonce": {"$ref": "#/$defs/base64url32"},
        "evidence": {"type": "object", "minProperties": 1},
        "cds_cert_pem": {"type": "string", "minLength": 1, "maxLength": 262144},
        "front_door_mode": {"type": "string", "minLength": 1},
        "serving_leaf_sha256": {"$ref": "#/$defs/base64url32"},
        "session_pubkey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x25519", "mlkem768"],
          "properties": {
            "x25519": {"$ref": "#/$defs/base64url"},
            "mlkem768": {"$ref": "#/$defs/base64url"}
          }
        },
        "xwing_ek": {"$ref": "#/$defs/base64urlXwingEk"},
        "xwing_ct": {"$ref": "#/$defs/base64urlXwingCt"},
        "session_id": {"$ref": "#/$defs/base64urlSessionId"},
        "identity_proof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "leaf_sha256", "mesh_ca_sha256", "signature"],
          "properties": {
            "algorithm": {"const": "ecdsa-sha384"},
            "leaf_sha256": {"$ref": "#/$defs/base64url"},
            "mesh_ca_sha256": {"$ref": "#/$defs/base64url"},
            "signature": {"$ref": "#/$defs/base64url"}
          }
        }
      }
    }
  }
}
