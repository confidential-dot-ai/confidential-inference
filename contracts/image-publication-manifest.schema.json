{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confidential.ai/schemas/image-publication-manifest/v2",
  "title": "Confidential inference image publication manifest",
  "description": "Evidence that each listed image was pushed with the digest of its deterministic rebuild audit. It names the image source commit, not a release: every release profile that pins this commit uses the same evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "images"
  ],
  "properties": {
    "schema": {
      "const": "confidential.ai/image-publication-manifest/v2"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "baseRef",
        "baseRefCommit"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/confidential-dot-ai/confidential-inference"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "baseRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "baseRefCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^ghcr\\.io/confidential-dot-ai/confidential-inference/[a-z0-9][a-z0-9._-]*$"
          },
          "digest": {
            "description": "The pushed digest, which equals the reproducibility audit digest.",
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
