diff --git a/src/sglang_simulator/simulation/sglang/launch_server.py b/src/sglang_simulator/simulation/sglang/launch_server.py
--- a/src/sglang_simulator/simulation/sglang/launch_server.py
+++ b/src/sglang_simulator/simulation/sglang/launch_server.py
@@ -42,6 +42,27 @@ def _has_cli_option(argv: list[str], option: str) -> bool:
     return any(arg == option or arg.startswith(f"{option}=") for arg in argv)
 
 
+def remove_noop_parser_options(argv: list[str]) -> list[str]:
+    """Accept parser options in simulator mode, but do not enable them."""
+    noop_options = {"--reasoning-parser", "--tool-call-parser"}
+    result = []
+    index = 0
+    while index < len(argv):
+        argument = argv[index]
+        option = argument.split("=", 1)[0]
+        if option not in noop_options:
+            result.append(argument)
+            index += 1
+            continue
+
+        if argument == option and index + 1 < len(argv):
+            index += 2
+        else:
+            index += 1
+
+    return result
+
+
 def apply_simulator_defaults(raw_args: argparse.Namespace, argv: list[str]) -> None:
     """Avoid real model execution while preserving explicit SGLang options."""
     if not _has_cli_option(argv, "--load-format"):
@@ -86,6 +107,7 @@ if __name__ == "__main__":
     SimulationArgs.add_cli_args(g)
 
     argv = sys.argv[1:]
+    argv = remove_noop_parser_options(argv)
     raw_args = parser.parse_args(argv)
     apply_simulator_defaults(raw_args, argv)
     apply_simulator_server_args(raw_args)
