diff --git a/src/sglang_simulator/simulation/sglang/openai_reasoning.py b/src/sglang_simulator/simulation/sglang/openai_reasoning.py
new file mode 100644
--- /dev/null
+++ b/src/sglang_simulator/simulation/sglang/openai_reasoning.py
@@ -0,0 +1,120 @@
+"""Return fixed reasoning responses from the GPU-free staging simulator."""
+
+import json
+import time
+import uuid
+from typing import Any, Optional
+
+from sglang_simulator.hook import BaseHook
+
+REASONING_TEXT = "This is simulated reasoning."
+ANSWER_TEXT = "This is a simulated answer."
+
+
+def _as_attr_or_key(obj: Any, name: str) -> Any:
+    if obj is None:
+        return None
+    if isinstance(obj, dict):
+        return obj.get(name)
+    return getattr(obj, name, None)
+
+
+def _thinking(request: Any) -> Optional[bool]:
+    kwargs = _as_attr_or_key(request, "chat_template_kwargs")
+    if not isinstance(kwargs, dict) or "thinking" not in kwargs:
+        return None
+    return kwargs["thinking"] is True
+
+
+def _usage(thinking: bool) -> dict[str, Any]:
+    reasoning_tokens = 4 if thinking else 0
+    completion_tokens = 8 if thinking else 4
+    return {
+        "prompt_tokens": 0,
+        "completion_tokens": completion_tokens,
+        "total_tokens": completion_tokens,
+        "completion_tokens_details": {"reasoning_tokens": reasoning_tokens},
+    }
+
+
+def _non_streaming_response(request: Any, thinking: bool, fastapi_responses):
+    message = {
+        "role": "assistant",
+        "content": ANSWER_TEXT,
+        "tool_calls": None,
+    }
+    if thinking:
+        message["reasoning_content"] = REASONING_TEXT
+    body = {
+        "id": f"chatcmpl-sim-{uuid.uuid4().hex}",
+        "object": "chat.completion",
+        "created": int(time.time()),
+        "model": _as_attr_or_key(request, "model"),
+        "choices": [
+            {
+                "index": 0,
+                "message": message,
+                "finish_reason": "stop",
+            }
+        ],
+        "usage": _usage(thinking),
+    }
+    return fastapi_responses.JSONResponse(body)
+
+
+def _streaming_response(request: Any, thinking: bool, fastapi_responses):
+    created = int(time.time())
+    chunk_id = f"chatcmpl-sim-{uuid.uuid4().hex}"
+    model = _as_attr_or_key(request, "model")
+
+    async def event_stream():
+        delta = {"role": "assistant"}
+        if thinking:
+            delta["reasoning_content"] = REASONING_TEXT
+        else:
+            delta["content"] = ANSWER_TEXT
+        first = {
+            "id": chunk_id,
+            "object": "chat.completion.chunk",
+            "created": created,
+            "model": model,
+            "choices": [{"index": 0, "delta": delta, "finish_reason": None}],
+        }
+        yield f"data: {json.dumps(first, separators=(',', ':'))}\n\n"
+        final = {
+            "id": chunk_id,
+            "object": "chat.completion.chunk",
+            "created": created,
+            "model": model,
+            "choices": [
+                {"index": 0, "delta": {}, "finish_reason": "stop"}
+            ],
+        }
+        yield f"data: {json.dumps(final, separators=(',', ':'))}\n\n"
+        yield "data: [DONE]\n\n"
+
+    return fastapi_responses.StreamingResponse(
+        event_stream(), media_type="text/event-stream"
+    )
+
+
+class C_OpenAIServingChatReasoningHook(BaseHook):
+    HOOK_CLASS_NAME = "OpenAIServingChat"
+    HOOK_MODULE_NAME = "sglang.srt.entrypoints.openai.serving_chat"
+
+    @classmethod
+    def hook(cls, target):
+        original_handle_request = target.handle_request
+
+        async def simulator_handle_request(self, request, raw_request):
+            thinking = _thinking(request)
+            if thinking is None:
+                return await original_handle_request(self, request, raw_request)
+
+            from fastapi import responses as fastapi_responses
+
+            if _as_attr_or_key(request, "stream"):
+                return _streaming_response(request, thinking, fastapi_responses)
+            return _non_streaming_response(request, thinking, fastapi_responses)
+
+        target.handle_request = simulator_handle_request
