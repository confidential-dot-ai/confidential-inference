@@ -0,0 +1,214 @@
+"""Simulator support for tool-call chat completions.
+
+The GPU-free simulator does not load model weights, so it cannot run a real
+model's tool-call grammar. This hook adds one deterministic path: when a
+chat completion request carries ``tools`` and either the prompt asks for one
+of them by name, or ``tool_choice`` names one, the simulator answers with a
+fixed OpenAI-shaped ``tool_calls`` entry instead of the usual deterministic
+prefix text. Every other request -- no ``tools``, or ``tools`` present but
+not requested -- keeps the simulator's existing generation path unchanged.
+"""
+
+import json
+import time
+import uuid
+from typing import Any, List, Optional
+
+from sglang_simulator.hook import BaseHook
+from sglang_simulator.utils import get_logger
+
+logger = get_logger("sgl_simulator")
+
+
+def _as_attr_or_key(obj: Any, name: str) -> Any:
+    """Read `name` from a pydantic model or a plain dict, whichever `obj` is."""
+    if obj is None:
+        return None
+    if isinstance(obj, dict):
+        return obj.get(name)
+    return getattr(obj, name, None)
+
+
+def _tool_function(tool: Any) -> Any:
+    return _as_attr_or_key(tool, "function")
+
+
+def _tool_name(tool: Any) -> Optional[str]:
+    function = _tool_function(tool)
+    return _as_attr_or_key(function, "name")
+
+
+def _tool_parameters(tool: Any) -> Any:
+    function = _tool_function(tool)
+    return _as_attr_or_key(function, "parameters")
+
+
+def _first_required_param(tool: Any) -> str:
+    """Pick the parameter name whose value goes in the fixed arguments object."""
+    parameters = _tool_parameters(tool)
+    if isinstance(parameters, dict):
+        required = parameters.get("required") or []
+        if required:
+            return required[0]
+        properties = parameters.get("properties") or {}
+        if properties:
+            return next(iter(properties))
+    return "value"
+
+
+def _message_text(request: Any) -> str:
+    """Collect the text of every message so the prompt can be scanned for a tool name."""
+    parts: List[str] = []
+    for message in _as_attr_or_key(request, "messages") or []:
+        content = _as_attr_or_key(message, "content")
+        if isinstance(content, str):
+            parts.append(content)
+        elif isinstance(content, list):
+            for part in content:
+                text = _as_attr_or_key(part, "text")
+                if isinstance(text, str):
+                    parts.append(text)
+    return " ".join(parts)
+
+
+def _tool_choice_names_a_tool(request: Any) -> bool:
+    tool_choice = _as_attr_or_key(request, "tool_choice")
+    if tool_choice is None:
+        return False
+    if isinstance(tool_choice, str):
+        return tool_choice == "required"
+    function = _as_attr_or_key(tool_choice, "function")
+    name = _as_attr_or_key(function, "name")
+    return bool(name)
+
+
+def _requested_tool(request: Any, tools: List[Any]) -> Optional[Any]:
+    """Return the tool this request asks for, or None if this is not a tool-call request.
+
+    The spec: a fixed ``tool_calls`` reply always echoes the *first* tool in
+    the list. This only decides whether that reply should be sent at all.
+    """
+    if not tools:
+        return None
+    if _tool_choice_names_a_tool(request):
+        return tools[0]
+    prompt = _message_text(request).lower()
+    for tool in tools:
+        name = _tool_name(tool)
+        if name and name.lower() in prompt:
+            return tools[0]
+    return None
+
+
+def _build_tool_call(tool: Any, protocol, call_id: str):
+    name = _tool_name(tool)
+    param = _first_required_param(tool)
+    arguments = json.dumps({param: "simulated"})
+    return protocol.ToolCall(
+        id=call_id,
+        index=0,
+        type="function",
+        function=protocol.FunctionResponse(name=name, arguments=arguments),
+    )
+
+
+def _non_streaming_response(request: Any, protocol, tool: Any):
+    created = int(time.time())
+    chunk_id = f"chatcmpl-sim-{uuid.uuid4().hex}"
+    call_id = f"call-sim-{uuid.uuid4().hex[:24]}"
+    tool_call = _build_tool_call(tool, protocol, call_id)
+    return protocol.ChatCompletionResponse(
+        id=chunk_id,
+        created=created,
+        model=_as_attr_or_key(request, "model"),
+        choices=[
+            protocol.ChatCompletionResponseChoice(
+                index=0,
+                message=protocol.ChatMessage(
+                    role="assistant",
+                    content=None,
+                    tool_calls=[tool_call],
+                ),
+                finish_reason="tool_calls",
+            )
+        ],
+        usage=protocol.UsageInfo(
+            prompt_tokens=0, completion_tokens=0, total_tokens=0
+        ),
+    )
+
+
+async def _streaming_response(request: Any, protocol, tool: Any, fastapi_responses):
+    created = int(time.time())
+    chunk_id = f"chatcmpl-sim-{uuid.uuid4().hex}"
+    call_id = f"call-sim-{uuid.uuid4().hex[:24]}"
+    tool_call = _build_tool_call(tool, protocol, call_id)
+    model = _as_attr_or_key(request, "model")
+
+    async def event_stream():
+        first = protocol.ChatCompletionStreamResponse(
+            id=chunk_id,
+            created=created,
+            model=model,
+            choices=[
+                protocol.ChatCompletionResponseStreamChoice(
+                    index=0,
+                    delta=protocol.DeltaMessage(
+                        role="assistant", tool_calls=[tool_call]
+                    ),
+                    finish_reason=None,
+                )
+            ],
+        )
+        yield f"data: {first.model_dump_json(exclude_none=True)}\n\n"
+
+        final = protocol.ChatCompletionStreamResponse(
+            id=chunk_id,
+            created=created,
+            model=model,
+            choices=[
+                protocol.ChatCompletionResponseStreamChoice(
+                    index=0,
+                    delta=protocol.DeltaMessage(),
+                    finish_reason="tool_calls",
+                )
+            ],
+        )
+        yield f"data: {final.model_dump_json(exclude_none=True)}\n\n"
+        yield "data: [DONE]\n\n"
+
+    return fastapi_responses.StreamingResponse(
+        event_stream(), media_type="text/event-stream"
+    )
+
+
+class C_OpenAIServingChatHook(BaseHook):
+    """Answer a tool-call chat completion deterministically; defer everything else."""
+
+    HOOK_CLASS_NAME = "OpenAIServingChat"
+    HOOK_MODULE_NAME = "sglang.srt.entrypoints.openai.serving_chat"
+
+    @classmethod
+    def hook(cls, target):
+        original_handle_request = target.handle_request
+
+        async def simulator_handle_request(self, request, raw_request):
+            tools = _as_attr_or_key(request, "tools") or []
+            tool = _requested_tool(request, tools)
+            if tool is None:
+                return await original_handle_request(self, request, raw_request)
+
+            from sglang.srt.entrypoints.openai import protocol
+            from fastapi import responses as fastapi_responses
+
+            logger.debug(
+                "Simulator answering a tool-call request with tool "
+                f"'{_tool_name(tool)}'"
+            )
+            if _as_attr_or_key(request, "stream"):
+                return await _streaming_response(
+                    request, protocol, tool, fastapi_responses
+                )
+            return _non_streaming_response(request, protocol, tool)
+
+        target.handle_request = simulator_handle_request
