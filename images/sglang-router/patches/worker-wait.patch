+    /// A request arriving while the only worker is unhealthy waits for it,
+    /// within --worker-wait-secs, instead of failing with 503.
+    #[tokio::test]
+    async fn test_request_waits_for_a_worker_to_become_available() {
+        let backend = axum::Router::new().route(
+            "/v1/completions",
+            axum::routing::post(|| async { Json(serde_json::json!({"ok": true})) }),
+        );
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("http://{}", listener.local_addr().unwrap());
+        let server = tokio::spawn(async move {
+            axum::serve(listener, backend).await.unwrap();
+        });
+        let request: CompletionRequest = serde_json::from_value(serde_json::json!({
+            "model": "test-model", "prompt": "test", "max_tokens": 2
+        }))
+        .unwrap();
+        let only_worker = |router: &Router| {
+            for (id, _) in router.worker_registry.get_all_with_ids() {
+                router.worker_registry.remove(&id);
+            }
+            let worker: Arc<dyn Worker> = Arc::new(BasicWorkerBuilder::new(&url).build());
+            worker.set_healthy(false);
+            router.worker_registry.register(worker.clone());
+            worker
+        };
+
+        // Without a wait budget the router answers 503 at once (after its retries).
+        let router = create_test_regular_router();
+        only_worker(&router);
+        let response = router
+            .route_typed_request(None, &request, "/v1/completions", None)
+            .await;
+        assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
+
+        let mut router = create_test_regular_router();
+        router.worker_wait = Duration::from_secs(10);
+        let worker = only_worker(&router);
+        let recover = tokio::spawn(async move {
+            tokio::time::sleep(Duration::from_millis(1500)).await;
+            worker.set_healthy(true);
+        });
+        let started = Instant::now();
+        let response = router
+            .route_typed_request(None, &request, "/v1/completions", None)
+            .await;
+        assert_eq!(response.status(), StatusCode::OK);
+        assert!(started.elapsed() >= Duration::from_millis(1400));
+        recover.await.unwrap();
+
+        // The budget is per request: once spent, the request fails without waiting again.
+        let mut router = create_test_regular_router();
+        router.worker_wait = Duration::from_millis(300);
+        only_worker(&router);
+        let started = Instant::now();
+        let response = router
+            .route_typed_request(None, &request, "/v1/completions", None)
+            .await;
+        assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
+        assert!(started.elapsed() < Duration::from_secs(5));
+        server.abort();
+    }
+
     fn create_test_regular_router() -> Router {
