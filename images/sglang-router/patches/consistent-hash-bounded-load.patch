+    /// With a load factor, a key stays on its worker while that worker is
+    /// within the bound, and spills to one fixed worker once it is not.
+    #[tokio::test]
+    async fn test_bounded_load_spills_a_full_worker() {
+        let workers = create_workers(&["http://w0:8000", "http://w1:8000", "http://w2:8000"]);
+        let ring = Arc::new(HashRing::new(&workers));
+        let headers = headers_with_routing_key("session-1");
+        let info = SelectWorkerInfo {
+            headers: Some(&headers),
+            hash_ring: Some(ring),
+            ..Default::default()
+        };
+        let unbounded = ConsistentHashingPolicy::new();
+        let bounded = ConsistentHashingPolicy::with_load_factor(1.25);
+        let home = unbounded.select_worker_impl(&workers, &info).0.unwrap();
+
+        // 3 in flight, all on home: capacity ceil(1.25 * 4 / 3) = 2, home is full.
+        for _ in 0..3 {
+            workers[home].increment_load();
+        }
+        assert_eq!(
+            unbounded.select_worker_impl(&workers, &info),
+            (Some(home), Branch::RoutingKeyHit)
+        );
+        let (spill, branch) = bounded.select_worker_impl(&workers, &info);
+        let spill = spill.unwrap();
+        assert_ne!(spill, home);
+        assert_eq!(branch, Branch::RoutingKeySpill);
+        for _ in 0..5 {
+            assert_eq!(bounded.select_worker_impl(&workers, &info).0, Some(spill));
+        }
+
+        // Once the others carry load too, home is within the bound again.
+        for (i, w) in workers.iter().enumerate() {
+            if i != home {
+                for _ in 0..2 {
+                    w.increment_load();
+                }
+            }
+        }
+        // 7 in flight: capacity ceil(1.25 * 8 / 3) = 4 > 3.
+        assert_eq!(
+            bounded.select_worker_impl(&workers, &info),
+            (Some(home), Branch::RoutingKeyHit)
+        );
+    }
+
