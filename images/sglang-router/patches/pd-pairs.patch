+fn parse_pd_pairs(raw: &str) -> Result<HashMap<String, String>, String> {
+    let invalid = || "Invalid PD pair configuration".to_string();
+    let pairs: HashMap<String, String> = serde_json::from_str(raw).map_err(|_| invalid())?;
+    let unique: std::collections::HashSet<_> = pairs.values().collect();
+    if pairs.len() != 2 || unique.len() != pairs.len() {
+        return Err(invalid());
+    }
+    for (prefill, decode) in &pairs {
+        let p = reqwest::Url::parse(prefill).map_err(|_| invalid())?;
+        let d = reqwest::Url::parse(decode).map_err(|_| invalid())?;
+        if p.scheme() != "http"
+            || d.scheme() != "http"
+            || p.host_str() != d.host_str()
+            || p.port().is_none()
+            || d.port().is_none()
+            || p.port() == d.port()
+            || [&p, &d].iter().any(|u| {
+                !u.username().is_empty()
+                    || u.password().is_some()
+                    || u.query().is_some()
+                    || u.fragment().is_some()
+                    || u.path() != "/"
+            })
+        {
+            return Err(invalid());
+        }
+    }
+    Ok(pairs)
+}
+
+// Exact peer pairs are release-owned environment. A missing or unhealthy
+// peer removes the complete pair from selection. Never cross pair boundaries.
+fn configured_pd_pairs() -> Result<Option<&'static HashMap<String, String>>, String> {
+    static PAIRS: OnceLock<Result<Option<HashMap<String, String>>, String>> = OnceLock::new();
+    match PAIRS.get_or_init(|| {
+        let raw = match std::env::var("CI_ROUTER_PD_PAIRS") {
+            Ok(value) => value,
+            Err(std::env::VarError::NotPresent) => return Ok(None),
+            Err(_) => return Err("Invalid PD pair configuration".to_string()),
+        };
+        let pairs = parse_pd_pairs(&raw)?;
+        Ok(Some(pairs))
+    }) {
+        Ok(Some(pairs)) => Ok(Some(pairs)),
+        Ok(None) => Ok(None),
+        Err(error) => Err(error.clone()),
+    }
+}
