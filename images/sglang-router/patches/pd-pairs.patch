+#[cfg(test)]
+mod pair_configuration_tests {
+    use super::parse_pd_pairs;
+
+    #[test]
+    fn pairs_stay_on_their_own_pod() {
+        let routes = parse_pd_pairs(r#"{"http://pair-a:8041":"http://pair-a:8043","http://pair-b:8042":"http://pair-b:8044"}"#)
+            .expect("valid pair configuration");
+        assert_eq!(
+            routes.get("http://pair-a:8041").map(String::as_str),
+            Some("http://pair-a:8043")
+        );
+    }
+
+    #[test]
+    fn cross_pod_pair_and_credential_urls_are_refused() {
+        for raw in [
+            r#"{"http://pair-a:8041":"http://pair-b:8043","http://pair-b:8042":"http://pair-b:8044"}"#,
+            r#"{"http://secret@pair-a:8041":"http://pair-a:8043","http://pair-b:8042":"http://pair-b:8044"}"#,
+            r#"{}"#,
+            r#"{"http://pair-a:8041":"http://pair-a:8043","http://pair-a:8042":"http://pair-a:8043"}"#,
+        ] {
+            assert!(parse_pd_pairs(raw).is_err());
+        }
+    }
