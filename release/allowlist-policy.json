{
  "schema": "confidential.ai/release-allowlist-policy/v2",
  "chart": {
    "release": "confidential-inference",
    "namespace": "confidential-inference",
    "kubeVersion": "1.32.0"
  },
  "kubernetes": {
    "serviceHost": "10.53.0.1"
  },
  "cdi": {
    "driverVersion": "595.71.05",
    "input": "release/inputs/cdi/nvidia-595.71.05.json"
  },
  "workloads": [
    {
      "name": "gateway-{release}",
      "controller": "Deployment/gateway-{release}",
      "secretReads": [
        "/confidential-inference/gateway/api-key-pepper"
      ]
    },
    {
      "name": "kube-state-metrics",
      "controller": "Deployment/kube-state-metrics"
    },
    {
      "name": "log-collector-ua59410a16b",
      "controller": "Deployment/log-collector"
    },
    {
      "name": "metrics-collector",
      "controller": "Deployment/metrics-collector"
    },
    {
      "name": "router-{release}",
      "controller": "Deployment/router-{release}"
    },
    {
      "name": "inference-worker-0-u200b5c252a",
      "controller": "StatefulSet/inference-worker-0"
    },
    {
      "name": "inference-worker-1-u5f71fa321d",
      "controller": "StatefulSet/inference-worker-1"
    }
  ]
}
