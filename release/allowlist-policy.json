{
  "schema": "confidential.ai/release-allowlist-policy/v2",
  "chart": {
    "release": "confidential-inference",
    "namespace": "confidential-inference",
    "kubeVersion": "1.32.0"
  },
  "kubernetes": {
    "serviceHost": "10.53.0.1"
  },
  "cdi": {
    "driverVersion": "595.71.05",
    "input": "release/inputs/cdi/nvidia-595.71.05.json"
  },
  "workloads": [
    {"name": "gateway", "controller": "Deployment/gateway",
     "secretReads": ["/confidential-inference/gateway/api-key-pepper"]},
    {"name": "inference-worker-0", "controller": "StatefulSet/inference-worker-0"},
    {"name": "inference-worker-1", "controller": "StatefulSet/inference-worker-1"},
    {"name": "kube-state-metrics", "controller": "Deployment/kube-state-metrics"},
    {"name": "metrics-collector", "controller": "Deployment/metrics-collector"},
    {"name": "sglang-router", "controller": "Deployment/sglang-router"}
  ]
}
